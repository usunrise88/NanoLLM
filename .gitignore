# Build output
/dist/
/nanollm
/nanollm.exe
/web/dist/
/web/node_modules/

# The SPA is staged here by `make web` and embedded at compile time. The
# placeholder page is committed so `go build` works in a fresh checkout; a
# binary that embeds only the placeholder reports ui=false and serves no UI.
/internal/ui/dist/*
!/internal/ui/dist/index.html

# Downloads: llama.cpp release archives (scripts/fetch-libs.sh) and weights.
/.cache/
/.models/
*.gguf

# Local state
/nanollm.yaml
/configs/nanollm.local.yaml
*.db
*.db-wal
*.db-shm

# Tooling
*.test
*.out
.DS_Store
.claude/worktrees/
