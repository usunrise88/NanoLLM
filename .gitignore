# Build output
/dist/
/nanollm
/nanollm.exe
/web/dist/
/web/node_modules/
/web/test-results/
/web/playwright-report/

# The SPA is staged here by `make web` and embedded at compile time. The
# placeholder page is committed so `go build` works in a fresh checkout; a
# binary that embeds only the placeholder reports ui=false and serves no UI.
/internal/ui/dist/*
!/internal/ui/dist/index.html

# Downloads: llama.cpp release archives (scripts/fetch-libs.sh) and weights.
/.cache/
/.models/
*.gguf

# Local state
/nanollm.yaml
/configs/nanollm.local.yaml
*.db
*.db-wal
*.db-shm

# Tooling
*.test
*.out
.DS_Store
.claude/worktrees/
__pycache__/
.pytest_cache/

# Private: the answers of the owner's gemma.json transcript, and what the stage-0 runs kept of them. Never committed.
answers.json
/bench/results/*/stage0-*/gemma/
/bench/results/*/stage0-*/raw/

# Scratch of the measurement drivers, profiler traces and the Vulkan bandwidth probe's binaries.
/bench/results/*/*/driver*.log
/bench/results/*/*/driver*.stdout.txt
/bench/results/*/*/standard-*.log
*.nsys-rep
*.sqlite
/bench/results/*/stage0-*/vkbw/vkbw.exe
/bench/results/*/stage0-*/vkbw/vkbw.obj
/bench/results/*/stage0-*/vkbw/read.spv
/llama.log
# The ik_llama.cpp server logs echo pieces of the prompt.
/bench/results/*/runtimes-comparison-*/raw/ik-*/serve.log
