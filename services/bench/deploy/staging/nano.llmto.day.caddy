# nano.llmto.day on hyper, behind the host's own Caddy. Installed to
# /etc/caddy/sites.d/ by
#
#   sudo scripts/staging-bench-service.sh caddy
#
# which validates the whole config as the caddy user before it reloads Caddy.
#
# Two upstreams, both on the loopback:
#   - benchd (services/bench), 127.0.0.1:27418: /benchmarks, /api/v1/* and /admin;
#   - the static site (site/), 127.0.0.1:27419: everything else, that is the
#     landing page of the Nano* family and the product pages.
#
# The site is open: the owner accepted the privacy and consent texts as they
# are. /admin is open from anywhere too; what it shows is not sensitive, and
# its API needs benchd's own bearer token (~/.config/nanollm-bench-staging/env).
#
# Access logs carry no client address, as in the Caddyfile next to this
# directory; benchd sees the address only in X-Forwarded-For, which Caddy sets.

nano.llmto.day {
	import common

	log {
		output file /var/log/caddy/nano.llmto.day.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}

	@bench path /benchmarks /benchmarks/* /api/v1/* /admin /admin/*
	handle @bench {
		request_body {
			max_size 300KB
		}
		reverse_proxy 127.0.0.1:27418
	}

	handle {
		reverse_proxy 127.0.0.1:27419
	}
}
