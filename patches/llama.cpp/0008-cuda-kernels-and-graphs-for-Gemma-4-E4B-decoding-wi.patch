     std::vector<cudaEvent_t> join_events;
     cudaEvent_t              fork_event = nullptr;
@@ -1457,13 +1474,16 @@ struct ggml_backend_cuda_context {
     int curr_stream_no = 0;
 
 #ifdef USE_CUDA_GRAPH
-    // Map from first_node_ptr to cuda_graph - allows multiple graphs per context
-    // when the computation is split across CPU/GPU (e.g., with --n-cpu-moe)
-    std::unordered_map<const void *, std::unique_ptr<ggml_cuda_graph>> cuda_graphs;
+    // Map from the graph key (first node, shape) to cuda_graph - allows multiple graphs per context
+    // when the computation is split across CPU/GPU (e.g., with --n-cpu-moe), or has several batch shapes
+    std::unordered_map<ggml_cuda_graph_key, std::unique_ptr<ggml_cuda_graph>, ggml_cuda_graph_key_hash> cuda_graphs;
 
     int64_t last_graph_eviction_sweep = 0;
 
-    ggml_cuda_graph * cuda_graph(const void * first_node_ptr) {
+    // a context that sees every batch size 1..N keeps N graphs; more than this is a program with no pattern
+    static constexpr size_t GGML_CUDA_MAX_GRAPHS = 32;
+
+    ggml_cuda_graph * cuda_graph(const ggml_cuda_graph_key & first_node_ptr) {
         const int64_t time_now = ggml_time_us();
 
         // sweep every 5s, evicting cuda graphs unused for >=10s
@@ -1480,6 +1500,15 @@ struct ggml_backend_cuda_context {
 
         auto it = cuda_graphs.find(first_node_ptr);
         if (it == cuda_graphs.end()) {
+            if (cuda_graphs.size() >= GGML_CUDA_MAX_GRAPHS) {
+                auto oldest = cuda_graphs.begin();
+                for (auto j = cuda_graphs.begin(); j != cuda_graphs.end(); ++j) {
+                    if (j->second->last_used_time < oldest->second->last_used_time) {
+                        oldest = j;
+                    }
+                }
+                cuda_graphs.erase(oldest);
+            }
             it = cuda_graphs.emplace(first_node_ptr, std::make_unique<ggml_cuda_graph>()).first;
         }
         it->second->last_used_time = time_now;
@@ -1547,6 +1576,30 @@ struct ggml_backend_cuda_context {
         return cublas_handles[device][curr_stream_no];
     }
 
+    // NanoLLM (GGML_CUDA_NANO_Q8_CACHE): the activation of a mul_mat_vec_q, quantized to q8_1 and kept until the end of
+    // the graph evaluation, under the tensor it came from. The next mul_mat_vec_q on the same tensor (q, k and v take
+    // one input) finds it instead of quantizing again, and a norm that writes the tensor can write the q8_1 as well
+    // (norm.cu). The memory is the context's own and never moves: a CUDA graph keeps the addresses it captured.
+    struct q8_1_cache {
+        std::unordered_map<const ggml_tensor *, void *> entries;
+        char * scratch = nullptr;
+        size_t size    = 0;
+        size_t used    = 0;
+        bool   failed  = false;
+    } q8_cache;
+
+    void * q8_cache_find(const ggml_tensor * t) const {
+        const auto it = q8_cache.entries.find(t);
+        return it == q8_cache.entries.end() ? nullptr : it->second;
+    }
+    // room for `bytes` of q8_1 of the tensor, registered under it; nullptr when there is none (the caller then
+    // quantizes into the pool, as upstream does)
+    void * q8_cache_alloc(const ggml_tensor * t, size_t bytes);
+    void q8_cache_reset() {
+        q8_cache.entries.clear();
+        q8_cache.used = 0;
+    }
+
     // pool
     std::unique_ptr<ggml_cuda_pool> pools[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS];
 
