 // try and fuse nodes and return the number of nodes to skip
+// NanoLLM (GGML_CUDA_NANO_NORM_Q8): whether the RMS_NORM + MUL at node i should also write the q8_1 of its result, which
+// pays when a mat-vec on quantized weights follows it (it then finds the q8_1 in the context's cache instead of
+// launching a quantize kernel of its own). The norm sees a handful of tokens, one row of weights, and the consumer
+// within the next few nodes (Q, K, V and the feed-forward gate and up are all that close).
+static bool ggml_cuda_norm_q8_wanted(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    if (!ggml_cuda_nano_get(GGML_CUDA_NANO_NORM_Q8) || !ggml_cuda_nano_get(GGML_CUDA_NANO_Q8_CACHE) || cuda_ctx->curr_stream_no != 0) {
+        return false;
+    }
+    const ggml_tensor * norm = cgraph->nodes[i];
+    const ggml_tensor * mul  = cgraph->nodes[i + 1];
+    const ggml_tensor * src  = norm->src[0];
+    const ggml_tensor * w    = mul->src[0] == norm ? mul->src[1] : mul->src[0];
+    if (src->type != GGML_TYPE_F32 || norm->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src->nb[0] != sizeof(float) || src->ne[2] != 1 || src->ne[3] != 1 || src->ne[0] % QK8_1 != 0 || src->ne[1] > MMVQ_MAX_BATCH_SIZE) {
+        return false;
+    }
+    if (w->ne[0] != src->ne[0] || ggml_nelements(w) != w->ne[0] || !ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, src)) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+    const int last = std::min(cgraph->n_nodes, i + 2 + 48);
+    for (int j = i + 2; j < last; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_MUL_MAT && n->src[1] == mul && ggml_is_quantized(n->src[0]->type) &&
+            ggml_cuda_should_use_mmvq(n->src[0]->type, cc, n->src[1]->ne[1])) {
+            return true;
+        }
+    }
+    return false;
+}
