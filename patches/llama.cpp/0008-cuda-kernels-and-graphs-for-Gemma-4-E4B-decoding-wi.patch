diff --git a/ggml/src/ggml-cuda/nano.cu b/ggml/src/ggml-cuda/nano.cu
new file mode 100644
index 000000000..a85efeb29
--- /dev/null
+++ b/ggml/src/ggml-cuda/nano.cu
@@ -0,0 +1,76 @@
+#include "nano.cuh"
+
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace {
+
+struct nano_def {
+    const char * name;
+    int          def;
+};
+
+const nano_def nano_defs[GGML_CUDA_NANO_COUNT] = {
+#define GGML_CUDA_NANO_DEF(name, def, doc) { #name, def },
+    GGML_CUDA_NANO_LIST(GGML_CUDA_NANO_DEF)
+#undef GGML_CUDA_NANO_DEF
+};
+
+std::atomic<int> nano_values[GGML_CUDA_NANO_COUNT];
+std::once_flag   nano_once;
+
+void nano_init() {
+    for (int i = 0; i < GGML_CUDA_NANO_COUNT; ++i) {
+        int v = nano_defs[i].def;
+        char var[64];
+        snprintf(var, sizeof(var), "GGML_CUDA_NANO_%s", nano_defs[i].name);
+        if (const char * s = getenv(var)) {
+            if (*s) {
+                v = atoi(s);
+            }
+        }
+        nano_values[i].store(v, std::memory_order_relaxed);
+    }
+}
+
+bool nano_equal(const char * a, const char * b) {
+    for (; *a && *b; ++a, ++b) {
+        if (toupper((unsigned char) *a) != toupper((unsigned char) *b)) {
+            return false;
+        }
+    }
+    return *a == *b;
+}
+
+} // namespace
+
+int ggml_cuda_nano_get(ggml_cuda_nano_id id) {
+    std::call_once(nano_once, nano_init);
+    return nano_values[id].load(std::memory_order_relaxed);
+}
+
+bool ggml_cuda_nano_set(const char * name, int value) {
+    std::call_once(nano_once, nano_init);
+    if (name == nullptr) {
+        return false;
+    }
+    for (int i = 0; i < GGML_CUDA_NANO_COUNT; ++i) {
+        if (nano_equal(name, nano_defs[i].name)) {
+            nano_values[i].store(value, std::memory_order_relaxed);
+            return true;
+        }
+    }
+    return false;
+}
+
+const char * ggml_cuda_nano_name(ggml_cuda_nano_id id) {
+    return nano_defs[id].name;
+}
+
+int ggml_cuda_nano_default(ggml_cuda_nano_id id) {
+    return nano_defs[id].def;
+}
