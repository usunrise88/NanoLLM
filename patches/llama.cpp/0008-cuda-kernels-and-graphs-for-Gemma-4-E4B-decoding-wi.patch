new file mode 100644
index 000000000..43daf869e
--- /dev/null
+++ b/ggml/src/ggml-cuda/nano.cuh
@@ -0,0 +1,45 @@
+#pragma once
+
+// NanoLLM: the switches of the kernels this series changes (patches/llama.cpp, the "cuda:" subjects).
+//
+// Every change has a switch, so that the build without it can be measured next to the build with it, in the same
+// DLL: GGML_CUDA_NANO_<NAME>=<integer> in the environment of the process, or
+// ggml_backend_cuda_nano_set("<NAME>", value) from the host program (an environment variable set after the process
+// has started does not reach the C runtime of a Windows DLL). It takes effect for the graphs that are computed
+// afterwards (a CUDA graph that is already captured keeps what it was captured with).
+//
+// A change that removes work without changing a result is on by default on every architecture. A change whose
+// best setting depends on the card (a table of kernel shapes) has a default per compute capability, and a
+// capability nobody has measured keeps upstream's choice. The names are listed in the NANO_* entries of the
+// backend's features (llama_print_system_info); NANOLLM there is the number of the last patch of the series, and
+// tells the host program that this is not upstream's DLL.
+
+#include <cstdint>
+
+#define GGML_CUDA_NANO_LEVEL 8
+
+// X(name, default, what it switches)
+#define GGML_CUDA_NANO_LIST(X) \
+    X(GRAPH_SHAPES,  1, "one CUDA graph per batch shape instead of one that is captured again after each change (1: on)") \
+    X(MMVQ_NWARPS,  -1, "block of the Q4_0 mat-vec for one token, warps*10 + rows: 11 12 14 21 22 24 31 32 34 44; 0 upstream's (41); -1 the table (the number of warps must be the same as for 2-4 tokens, or a draft's verification stops reproducing plain decoding)") \
+    X(MMVQ_NWARPS_N,-1, "the same for 2-4 tokens (the verification of a draft); 0 upstream's (42); -1 the table") \
+    X(FUSE_BATCH,    0, "the gate/up GEGLU (and bias) fusion of Q4_0 mat-vecs also for 2-4 tokens (1: on; off by default: on cc 8.6 the fused kernel of 4 tokens takes 156 us, 89 us with a one-warp block, against 87 us for the two mat-vecs and the GEGLU launch it replaces)") \
+    X(Q8_CACHE,      1, "the q8_1 of an activation is kept for the next mat-vec on it (q, k and v take one) (1: on)") \
+    X(NORM_LEAN,     3, "rms_norm*weight(+residual)(*scale) of a short row in one block of one float4 per thread (bit 0: without a residual, bit 1: with it)") \
+    X(GELU_MUL,      1, "gelu(x) * y in one launch (Gemma 4's per-layer embedding gate) (1: on)") \
+    X(FA_VEC,        0, "flash attention of one token with the vector kernel on Ampere, as upstream does from Ada (1: on)") \
+    X(NORM_Q8,       1, "rms_norm*weight also writes the q8_1 for the mat-vecs that follow it (1: on; needs Q8_CACHE)")
+
+enum ggml_cuda_nano_id {
+#define GGML_CUDA_NANO_ENUM(name, def, doc) GGML_CUDA_NANO_##name,
+    GGML_CUDA_NANO_LIST(GGML_CUDA_NANO_ENUM)
+#undef GGML_CUDA_NANO_ENUM
+    GGML_CUDA_NANO_COUNT
+};
+
+// the value of a switch: set by the host program, else the environment, else the default.
+int  ggml_cuda_nano_get(ggml_cuda_nano_id id);
+// by name (case-insensitive, without the GGML_CUDA_NANO_ prefix); false if there is no such switch.
+bool ggml_cuda_nano_set(const char * name, int value);
+const char * ggml_cuda_nano_name(ggml_cuda_nano_id id);
+int  ggml_cuda_nano_default(ggml_cuda_nano_id id);
