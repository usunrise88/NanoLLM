+// NanoLLM (GGML_CUDA_NANO_NORM_LEAN): RMS_NORM, MUL, ADD and the MUL by a one-element tensor that follows (Gemma 4's
+// per-layer output scale after the per-layer embedding's norm and residual) in one launch.
+struct norm_add_scale_args {
+    const ggml_tensor * x;
+    const ggml_tensor * mul;
+    const ggml_tensor * add;
+    float eps;
+};
+
+static norm_add_scale_args norm_add_scale_get(const ggml_tensor * dst, const ggml_tensor * mul_tensor, const ggml_tensor * add_tensor) {
+    norm_add_scale_args a;
+    a.x   = dst->src[0];
+    a.mul = mul_tensor->src[0] == dst ? mul_tensor->src[1] : mul_tensor->src[0];
+    a.add = add_tensor->src[0] == mul_tensor ? add_tensor->src[1] : add_tensor->src[0];
+    memcpy(&a.eps, dst->op_params, sizeof(float));
+    return a;
+}
+
+bool ggml_cuda_rms_norm_fused_add_scale_ok(const ggml_tensor * dst, const ggml_tensor * mul_tensor, const ggml_tensor * add_tensor,
+                                           const ggml_tensor * scale_tensor) {
+    const norm_add_scale_args a = norm_add_scale_get(dst, mul_tensor, add_tensor);
+    const ggml_tensor * s = scale_tensor->src[0] == add_tensor ? scale_tensor->src[1] : scale_tensor->src[0];
+    if (a.x->type != GGML_TYPE_F32 || a.mul->type != GGML_TYPE_F32 || a.add->type != GGML_TYPE_F32 || s->type != GGML_TYPE_F32 ||
+            scale_tensor->type != GGML_TYPE_F32 || add_tensor->type != GGML_TYPE_F32 || ggml_nelements(s) != 1 ||
+            a.x->nb[0] != sizeof(float) || a.mul->nb[0] != sizeof(float) || a.add->nb[0] != sizeof(float) ||
+            !ggml_is_contiguous(scale_tensor) || !ggml_are_same_shape(scale_tensor, add_tensor)) {
+        return false;
+    }
+    return rms_norm_lean_ok((const float *) a.x->data, (const float *) scale_tensor->data, (const float *) a.mul->data,
+                            (const float *) a.add->data, a.x->ne[0], a.x->ne[1], a.x->ne[2], a.x->ne[3], a.x->nb[1] / sizeof(float),
+                            a.x->nb[2] / sizeof(float), a.mul->ne[0], a.mul->ne[1], a.mul->ne[2], a.mul->ne[3],
+                            a.add->nb[1] / sizeof(float), a.add->ne[0], a.add->ne[1], a.add->ne[2], a.add->ne[3]);
+}
+
+void ggml_cuda_op_rms_norm_fused_add_scale(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor,
+                                           ggml_tensor * add_tensor, ggml_tensor * scale_tensor) {
+    const norm_add_scale_args a = norm_add_scale_get(dst, mul_tensor, add_tensor);
+    const ggml_tensor * s = scale_tensor->src[0] == add_tensor ? scale_tensor->src[1] : scale_tensor->src[0];
+    GGML_ASSERT(ggml_cuda_rms_norm_fused_add_scale_ok(dst, mul_tensor, add_tensor, scale_tensor));
+
+    const int ncols    = a.x->ne[0];
+    const int nrows    = a.x->ne[1];
+    const int nthreads = ((ncols / 4 + WARP_SIZE - 1) / WARP_SIZE) * WARP_SIZE;
+    rms_norm_mul_lean_f32<true, true><<<nrows, nthreads, 0, ctx.stream()>>>(
+        (const float *) a.x->data, (float *) scale_tensor->data, (const float *) a.mul->data, (const float *) a.add->data,
+        (const float *) s->data, ncols, a.x->nb[1] / sizeof(float), 0, a.add->nb[1] / sizeof(float), a.eps);
+}
