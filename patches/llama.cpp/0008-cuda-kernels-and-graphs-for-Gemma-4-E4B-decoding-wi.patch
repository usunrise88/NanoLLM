+// Which CUDA graph a ggml graph is cached under: its first node, and (GGML_CUDA_NANO_GRAPH_SHAPES) its shape.
+// The first node alone is the same for every batch size of one model, so a decode that alternates between batch
+// sizes (the verification of a speculative draft of a changing length) found a graph that did not match, ran
+// eagerly and captured it again, over and over. One graph per shape settles after two calls of each.
+struct ggml_cuda_graph_key {
+    const void * first_node = nullptr;
+    uint64_t     shape      = 0;
+
+    bool operator==(const ggml_cuda_graph_key & o) const { return first_node == o.first_node && shape == o.shape; }
+};
+
+struct ggml_cuda_graph_key_hash {
+    size_t operator()(const ggml_cuda_graph_key & k) const {
+        return std::hash<const void *>()(k.first_node) ^ (std::hash<uint64_t>()(k.shape) * 0x9E3779B97F4A7C15ull);
+    }
+};
+
