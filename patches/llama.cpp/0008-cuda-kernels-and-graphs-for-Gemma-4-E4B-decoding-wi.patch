+void * ggml_backend_cuda_context::q8_cache_alloc(const ggml_tensor * t, size_t bytes) {
+    constexpr size_t scratch_bytes = 8u << 20; // 1 token: ~1.1 MiB for the 42 layers of Gemma 4 E4B, 4 tokens: ~4.4 MiB
+    constexpr size_t align         = 256;
+    if (q8_cache.failed) {
+        return nullptr;
+    }
+    if (q8_cache.scratch == nullptr) {
+        ggml_cuda_set_device(device);
+        void * p = nullptr;
+        if (cudaMalloc(&p, scratch_bytes) != cudaSuccess) {
+            (void) cudaGetLastError();
+            q8_cache.failed = true;
+            return nullptr;
+        }
+        q8_cache.scratch = (char *) p;
+        q8_cache.size    = scratch_bytes;
+    }
+    const size_t at = GGML_PAD(q8_cache.used, align);
+    if (at + bytes > q8_cache.size) {
+        return nullptr;
+    }
+    q8_cache.used = at + bytes;
+    void * ptr = q8_cache.scratch + at;
+    q8_cache.entries[t] = ptr;
+    return ptr;
+}
