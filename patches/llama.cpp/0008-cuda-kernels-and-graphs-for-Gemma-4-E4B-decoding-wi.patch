index 000000000..d341cf6a0
--- /dev/null
+++ b/tests/test-nano-batch-invariance.cpp
@@ -0,0 +1,121 @@
+// NanoLLM: a token verified in a batch must get the bits it would get alone. Speculative decoding checks a draft by
+// evaluating several tokens at once and promises the tokens plain decoding would give; kernels that add up the same row
+// in another order for another number of columns make the two differ by rounding, and the int8 activations of a
+// quantized model turn a rounding into a flipped value. This evaluates the Q4_0 matrices that Gemma 4 E4B multiplies a
+// few tokens by with 1, 2, 3 and 4 columns, the first column the same, and compares the first column bit for bit; for
+// the feed-forward's shape also the gate and up with the GEGLU, which the CUDA backend fuses for one column and runs
+// as three launches for more.
+//
+//   test-nano-batch-invariance [dir with the backends] [m k]...
+//
+// Exit status 1 if some matrix differs. Run it with GGML_CUDA_NANO_* in the environment to see which switch breaks it.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static std::vector<float> eval_cols(ggml_backend_t backend, const std::vector<uint8_t> & wup, const std::vector<uint8_t> & wgate,
+        int64_t k, int64_t m, const std::vector<float> & act, int n, bool geglu) {
+    ggml_init_params ip = { ggml_tensor_overhead() * 16 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * up = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, k, m);
+    ggml_tensor * gate_w = geglu ? ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, k, m) : nullptr;
+    ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+    ggml_tensor * out = ggml_mul_mat(ctx, up, b);
+    if (geglu) {
+        ggml_tensor * gate = ggml_mul_mat(ctx, gate_w, b);
+        out = ggml_glu_split(ctx, gate, out, GGML_GLU_OP_GEGLU);
+    }
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, out);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    ggml_backend_tensor_set(up, wup.data(), 0, wup.size());
+    if (geglu) {
+        ggml_backend_tensor_set(gate_w, wgate.data(), 0, wgate.size());
+    }
+    ggml_backend_tensor_set(b, act.data(), 0, sizeof(float) * k * n);
+    ggml_backend_graph_compute(backend, gf);
+    std::vector<float> res(m * n);
+    ggml_backend_tensor_get(out, res.data(), 0, sizeof(float) * m * n);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    return res;
+}
+
+static std::vector<uint8_t> random_q4_0(std::mt19937 & rng, int64_t m, int64_t k) {
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float> w((size_t) m * k);
+    for (auto & v : w) {
+        v = nd(rng);
+    }
+    std::vector<uint8_t> q(ggml_row_size(GGML_TYPE_Q4_0, k) * m);
+    ggml_quantize_chunk(GGML_TYPE_Q4_0, w.data(), q.data(), 0, m, k, nullptr);
+    return q;
+}
+
+int main(int argc, char ** argv) {
+    if (argc > 1) {
+        ggml_backend_load_all_from_path(argv[1]);
+    } else {
+        ggml_backend_load_all();
+    }
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (!dev) {
+        fprintf(stderr, "no GPU backend\n");
+        return 77; // skipped
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    printf("device: %s\n", ggml_backend_dev_description(dev));
+
+    std::vector<std::pair<int64_t, int64_t>> shapes = {
+        {2048, 2560}, {4096, 2560}, {512, 2560}, {1024, 2560}, {2560, 2048}, {2560, 4096}, {10240, 2560}, {2560, 10240},
+        {256, 2560}, {2560, 256}, {10752, 2560}, {262144, 2560},
+    };
+    if (argc > 3) {
+        shapes.clear();
+        for (int i = 2; i + 1 < argc; i += 2) {
+            shapes.push_back({atoll(argv[i]), atoll(argv[i + 1])});
+        }
+    }
+
+    std::mt19937 rng(7);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    int bad = 0;
+    for (auto [m, k] : shapes) {
+        const std::vector<uint8_t> wup   = random_q4_0(rng, m, k);
+        const std::vector<uint8_t> wgate = random_q4_0(rng, m, k);
+        std::vector<float> act((size_t) k * 4);
+        for (auto & v : act) {
+            v = nd(rng);
+        }
+        const bool ffn = k == 2560 && m >= 8192 && m <= 16384; // the shape of the feed-forward's gate and up
+        for (int variant = 0; variant < (ffn ? 2 : 1); ++variant) {
+            const bool geglu = variant == 1;
+            const std::vector<float> one = eval_cols(backend, wup, wgate, k, m, act, 1, geglu);
+            printf("%7lld x %-6lld %s", (long long) m, (long long) k, geglu ? "gate+up+geglu" : "             ");
+            for (int n = 2; n <= 4; ++n) {
+                const std::vector<float> many = eval_cols(backend, wup, wgate, k, m, act, n, geglu);
+                int64_t differ = 0;
+                for (int64_t i = 0; i < m; ++i) {
+                    if (memcmp(&one[i], &many[i], sizeof(float)) != 0) {
+                        ++differ;
+                    }
+                }
+                printf("  %d cols: %s", n, differ == 0 ? "same" : "DIFFERENT");
+                if (differ) {
+                    printf(" (%lld rows)", (long long) differ);
+                    ++bad;
+                }
+            }
+            printf("\n");
+        }
+    }
+    ggml_backend_free(backend);
+    return bad ? 1 : 0;
+}
