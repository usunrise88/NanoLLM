From df1c2a2cc71515fd0540079c2220edf6b127296d Mon Sep 17 00:00:00 2001
From: NanoLLM <nanollm@localhost>
Date: Fri, 23 Oct 2026 12:00:00 +0000
Subject: [PATCH] llama: an output shortlist, the logits of a subset of the
 vocabulary

llama_model_set_output_shortlist (staging header) gives a model with a tied Q4_0 head a second, smaller copy of
the output matrix: the rows of the listed tokens, in the buffer type the head lives in (repacked on a CPU). A context
with llama_set_output_shortlist(ctx, true) ends its Gemma 4 graph in that copy, so the head reads n_ids rows instead
of n_vocab, and llama_decode writes -INFINITY for the tokens that are not listed, which gives every consumer of the
logits a full row. The flag is part of the graph-reuse check and makes the scheduler reserve again when it
changes, so it is switched only when a request needs the whole vocabulary.
---
 src/llama-context.cpp | 34 ++++++++++++++++++-
 src/llama-context.h   |  4 +++
 src/llama-cparams.h   |  1 +
 src/llama-ext.h       | 18 ++++++++++
 src/llama-graph.h     |  1 +
 src/llama-model.cpp   | 77 +++++++++++++++++++++++++++++++++++++++++++
 src/llama-model.h     |  8 +++++
 src/models/gemma4.cpp |  8 ++++-
 8 files changed, 149 insertions(+), 2 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 993328d..57d6102 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -204,6 +204,7 @@ llama_context::llama_context(
     cparams.embeddings              = params.embeddings;
     cparams.embeddings_nextn        = false;
     cparams.embeddings_nextn_masked = false;
+    cparams.output_shortlist        = false;
     cparams.offload_kqv             = params.offload_kqv;
     cparams.no_perf                 = params.no_perf;
     cparams.warmup                  = false;
@@ -1345,6 +1346,17 @@ void llama_context::set_embeddings_nextn(bool value, bool masked) {
     cparams.embeddings_nextn_masked = masked;
 }
 
+void llama_context::set_output_shortlist(bool value) {
+    value = value && model.output_short != nullptr;
+
+    if (cparams.output_shortlist != value) {
+        // the graph ends in a different matrix
+        sched_need_reserve = true;
+    }
+
+    cparams.output_shortlist = value;
+}
+
 void llama_context::set_embeddings_layer_inp(uint32_t lid, bool enable) {
     LLAMA_LOG_DEBUG("%s: lid = %d, enable = %d\n", __func__, lid, enable);
 
@@ -2058,7 +2070,23 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
             if (n_outputs) {
                 GGML_ASSERT( n_outputs_prev + n_outputs <= n_outputs_all);
                 GGML_ASSERT((n_outputs_prev + n_outputs)*n_vocab <= (int64_t) logits.size);
-                ggml_backend_tensor_get_async(backend_res, t_logits, logits_out, 0, n_outputs*n_vocab*sizeof(float));
+                if (cparams.output_shortlist && model.output_short && t_logits->ne[0] == (int64_t) model.output_short_ids.size()) {
+                    // the shortlist: n_ids logits per output; every other token gets -INFINITY
+                    const int64_t n_ids = (int64_t) model.output_short_ids.size();
+                    logits_short.resize(n_outputs*n_ids);
+                    ggml_backend_tensor_get_async(backend_res, t_logits, logits_short.data(), 0, n_outputs*n_ids*sizeof(float));
+                    ggml_backend_sched_synchronize(sched.get());
+                    for (int32_t i = 0; i < n_outputs; ++i) {
+                        float * row = logits_out + (int64_t) i*n_vocab;
+                        std::fill(row, row + n_vocab, -INFINITY);
+                        const float * src = logits_short.data() + i*n_ids;
+                        for (int64_t j = 0; j < n_ids; ++j) {
+                            row[model.output_short_ids[j]] = src[j];
+                        }
+                    }
+                } else {
+                    ggml_backend_tensor_get_async(backend_res, t_logits, logits_out, 0, n_outputs*n_vocab*sizeof(float));
+                }
             }
         }
 
@@ -4259,6 +4287,10 @@ void llama_set_embeddings_nextn(llama_context * ctx, bool value, bool masked) {
     ctx->set_embeddings_nextn(value, masked);
 }
 
+void llama_set_output_shortlist(llama_context * ctx, bool value) {
+    ctx->set_output_shortlist(value);
+}
+
 void llama_set_embeddings_layer_inp(llama_context * ctx, uint32_t lid, bool value) {
     ctx->set_embeddings_layer_inp(lid, value);
 }
diff --git a/src/llama-context.h b/src/llama-context.h
index 6938fb1..eca0fd1 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -119,6 +119,7 @@ struct llama_context {
 
     void set_embeddings (bool value);
     void set_embeddings_nextn(bool value, bool masked);
+    void set_output_shortlist(bool value);
     void set_embeddings_layer_inp(uint32_t lid, bool enable);
     void set_nextn_layer_offset(int32_t offset);
     void set_causal_attn(bool value);
@@ -368,6 +369,9 @@ private:
 
     bool sched_need_reserve = true;
 
+    // the logits of the output shortlist before they are spread over the vocabulary
+    std::vector<float> logits_short;
+
     // whether the reserve graph has a logits tensor, set in sched_reserve()
     // true until then, because the first output_reserve() runs before any graph is reserved
     bool graph_has_logits = true;
diff --git a/src/llama-cparams.h b/src/llama-cparams.h
index 3894784..6e44e1e 100644
--- a/src/llama-cparams.h
+++ b/src/llama-cparams.h
@@ -35,6 +35,7 @@ struct llama_cparams {
     bool embeddings;
     bool embeddings_nextn;        // also extract the hidden state before the final output norm
     bool embeddings_nextn_masked; // extract for only rows where batch.logits != 0
+    bool output_shortlist;        // compute the logits of the model's output shortlist only
     bool causal_attn;
