     bool flash_attn;
diff --git a/src/llama-ext.h b/src/llama-ext.h
index b8c5e80..18998d0 100644
--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -98,6 +98,24 @@ LLAMA_API std::vector<ggml_backend_buffer_t> llama_memory_get_buffers(const llam
 // Useful for testing purposes.
 LLAMA_API void llama_model_set_attn_rot(struct llama_model * model, bool value);
 
+// Output shortlist: the logits of a subset of the vocabulary only.
+//
+// The head of a tied model reads the whole token embedding matrix on every token (360 MiB of the 2.6 GiB
+// Gemma 4 E4B reads), and a few tokens never come out of it in practice. The model keeps a second,
+// smaller copy of the matrix with the rows of the listed tokens; a context with the shortlist on computes
+// n_ids logits instead of n_vocab and writes -INFINITY for every other token, so the sampler, the grammar
+// and the logits getters see a full row.
+//
+// ids: ascending, unique, within the vocabulary; n_ids a multiple of 8 (the repacked kernels work in
+// groups of 8 rows). The head must be a tied Q4_0 matrix in host memory (the CPU backend); otherwise
+// the call returns false and nothing changes. ids == NULL (or n_ids == 0) drops a shortlist.
+// Call it before creating the contexts that use it.
+LLAMA_API bool llama_model_set_output_shortlist(struct llama_model * model, const int32_t * ids, int32_t n_ids);
+
+// Turn the shortlist on or off for the next llama_decode of this context (no-op without one in the model).
+// Changing it makes the scheduler reserve its graph again, so switch only when the need changes.
+LLAMA_API void llama_set_output_shortlist(struct llama_context * ctx, bool value);
+
 // Set whether the context outputs nextn embeddings or not
 // If masked == true,  output the embeddings only for the tokens with batch.logits != 0
 // If masked == false, output the embeddings for all tokens in the batch regardless of batch.logits
diff --git a/src/llama-graph.h b/src/llama-graph.h
index e853a02..dd59c90 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -896,6 +896,7 @@ struct llm_graph_params {
             cparams.embeddings              == other.cparams.embeddings              &&
             cparams.embeddings_nextn        == other.cparams.embeddings_nextn        &&
             cparams.embeddings_nextn_masked == other.cparams.embeddings_nextn_masked &&
+            cparams.output_shortlist        == other.cparams.output_shortlist        &&
             cparams.causal_attn             == other.cparams.causal_attn             &&
             arch  == other.arch  &&
             gtype == other.gtype &&
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index aeab7b7..1291f53 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1331,6 +1331,74 @@ llama_model::~llama_model() {
     for (auto * lora : loras) {
         delete lora;
     }
+    set_output_shortlist(nullptr, 0);
+}
+
+bool llama_model::set_output_shortlist(const int32_t * ids, int32_t n_ids) {
+    if (output_short_buf) {
+        ggml_backend_buffer_free(output_short_buf);
+        output_short_buf = nullptr;
+    }
+    if (output_short_ctx) {
+        ggml_free(output_short_ctx);
+        output_short_ctx = nullptr;
+    }
+    output_short = nullptr;
+    output_short_ids.clear();
+
+    if (ids == nullptr || n_ids <= 0) {
+        return true;
+    }
+
+    // The rows come from the token embedding (the head is tied to it), which has to be Q4_0 in host memory;
+    // the copy goes into the buffer type the head lives in, so a repacked head gets a repacked shortlist.
+    if (!output || !tok_embd || !output->buffer || !tok_embd->buffer ||
+            output->type != GGML_TYPE_Q4_0 || tok_embd->type != GGML_TYPE_Q4_0 ||
+            tok_embd->ne[0] != output->ne[0] || tok_embd->ne[1] != output->ne[1] ||
+            strcmp(ggml_get_name(output), ggml_get_name(tok_embd)) != 0 ||
+            !ggml_backend_buffer_is_host(tok_embd->buffer) || tok_embd->data == nullptr) {
+        LLAMA_LOG_WARN("%s: the output matrix is not a tied Q4_0 head in host memory; no shortlist\n", __func__);
+        return false;
+    }
+    const int64_t n_vocab_ = tok_embd->ne[1];
+    if (n_ids % 8 != 0 || n_ids >= n_vocab_) {
+        LLAMA_LOG_WARN("%s: %d ids (a multiple of 8 below the vocabulary size %lld is needed); no shortlist\n", __func__, n_ids, (long long) n_vocab_);
+        return false;
+    }
+    for (int32_t i = 0; i < n_ids; ++i) {
+        if (ids[i] < 0 || ids[i] >= n_vocab_ || (i > 0 && ids[i] <= ids[i - 1])) {
+            LLAMA_LOG_WARN("%s: the ids must be ascending, unique and within the vocabulary (id %d at %d)\n", __func__, ids[i], i);
+            return false;
+        }
+    }
+
+    ggml_init_params ip = { ggml_tensor_overhead() * 2 + 1024, nullptr, true };
+    output_short_ctx = ggml_init(ip);
+    if (!output_short_ctx) {
+        return false;
+    }
+    output_short = ggml_new_tensor_2d(output_short_ctx, GGML_TYPE_Q4_0, tok_embd->ne[0], n_ids);
+    ggml_set_name(output_short, "output_short.weight");
+    output_short_buf = ggml_backend_alloc_ctx_tensors_from_buft(output_short_ctx, ggml_backend_buffer_get_type(output->buffer));
+    if (!output_short_buf) {
+        LLAMA_LOG_WARN("%s: no memory for the shortlist; no shortlist\n", __func__);
+        ggml_free(output_short_ctx);
+        output_short_ctx = nullptr;
+        output_short = nullptr;
+        return false;
+    }
+
+    const size_t row = ggml_row_size(GGML_TYPE_Q4_0, tok_embd->ne[0]);
+    std::vector<uint8_t> staging((size_t) n_ids * row);
+    for (int32_t i = 0; i < n_ids; ++i) {
+        memcpy(staging.data() + (size_t) i * row, (const uint8_t *) tok_embd->data + (size_t) ids[i] * row, row);
+    }
+    ggml_backend_tensor_set(output_short, staging.data(), 0, staging.size());
+    output_short_ids.assign(ids, ids + n_ids);
+
+    LLAMA_LOG_INFO("%s: output shortlist of %d of %lld rows, %.1f MiB (%s)\n", __func__, n_ids, (long long) n_vocab_,
+            ggml_backend_buffer_get_size(output_short_buf) / 1024.0 / 1024.0, ggml_backend_buffer_name(output_short_buf));
+    return true;
 }
 
 void llama_model_base::load_stats(llama_model_loader & ml) {
@@ -3788,6 +3856,15 @@ void llama_model_set_attn_rot(struct llama_model * model, bool value) {
     model->attn_rot = value;
 }
 
+bool llama_model_set_output_shortlist(struct llama_model * model, const int32_t * ids, int32_t n_ids) {
+    try {
+        return model->set_output_shortlist(ids, n_ids);
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, err.what());
+        return false;
+    }
+}
+
 //
 // llama_model_base
 //
diff --git a/src/llama-model.h b/src/llama-model.h
index bc640e0..6a83d5e 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -709,6 +709,14 @@ struct llama_model {
     struct ggml_tensor * output_b        = nullptr;
     struct ggml_tensor * output_norm_enc = nullptr;
 
+    // the shortlist of the output matrix (llama_model_set_output_shortlist)
+    struct ggml_tensor * output_short = nullptr;
+    std::vector<int32_t> output_short_ids; // vocabulary id of each row of output_short, ascending
+    ggml_context * output_short_ctx = nullptr;
+    ggml_backend_buffer_t output_short_buf = nullptr;
+
+    bool set_output_shortlist(const int32_t * ids, int32_t n_ids);
+
 
     // NVFP4 per-tensor scale2, input_scale for LM head
     struct ggml_tensor * output_s    = nullptr;
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 083904f..0294712 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -459,7 +459,13 @@ llama_model_gemma4::graph::graph(const llama_model & model, const llm_graph_para
     res->t_embd = cur;
 
     // lm_head
-    cur = build_lora_mm(model.output, cur, model.output_s);
+    // a context with the shortlist on ends in the smaller copy of the matrix: n_ids logits per row
+    // instead of n_vocab, spread over the vocabulary when they are read back (llama_context::decode)
+    if (cparams.output_shortlist && model.output_short) {
+        cur = build_lora_mm(model.output_short, cur, nullptr);
+    } else {
+        cur = build_lora_mm(model.output, cur, model.output_s);
+    }
 
     if (hparams.f_final_logit_softcapping) {
         cur = ggml_scale(ctx0, cur, 1.0f / hparams.f_final_logit_softcapping);
-- 
