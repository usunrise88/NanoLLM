 common/arg.cpp                    | 8 +++++---
 include/llama.h                   | 3 +++
 src/llama-context.cpp             | 2 ++
 src/llama-cparams.h               | 1 +
 src/llama-graph.cpp               | 7 ++++++-
 src/llama.cpp                     | 2 ++
 tools/llama-bench/llama-bench.cpp | 6 ++++--
 tools/mtmd/mtmd.cpp               | 1 +
 8 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index 6bc4a84e2..37c14506e 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -1754,11 +1754,13 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.n_chunks = value;
         }
     ).set_examples({LLAMA_EXAMPLE_IMATRIX, LLAMA_EXAMPLE_PERPLEXITY, LLAMA_EXAMPLE_RETRIEVAL}));
-    add_opt(common_arg({ "-fa", "--flash-attn" }, "[on|off|auto]",
-                       string_format("set Flash Attention use ('on', 'off', or 'auto', default: '%s')",
+    add_opt(common_arg({ "-fa", "--flash-attn" }, "[on|off|auto|small_batch]",
+                       string_format("set Flash Attention use ('on', 'off', 'auto', or 'small_batch', default: '%s')",
                                      llama_flash_attn_type_name(params.flash_attn_type)),
                        [](common_params & params, const std::string & value) {
-                           if (is_truthy(value)) {
+                           if (value == "small_batch") {
+                               params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_SMALL_BATCH;
+                           } else if (is_truthy(value)) {
                                params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
                            } else if (is_falsey(value)) {
                                params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
diff --git a/include/llama.h b/include/llama.h
index f15ca9f75..a965d27cd 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -193,6 +193,9 @@ extern "C" {
         LLAMA_FLASH_ATTN_TYPE_AUTO     = -1,
         LLAMA_FLASH_ATTN_TYPE_DISABLED = 0,
         LLAMA_FLASH_ATTN_TYPE_ENABLED  = 1,
+        // flash attention for batches of up to 8 tokens and on sliding-window layers; longer batches on the other
+        // layers use the matmul attention. The KV cache keeps the flash-attention layout (needs an unquantized cache).
+        LLAMA_FLASH_ATTN_TYPE_SMALL_BATCH = 2,
     };
 
     LLAMA_API const char * llama_flash_attn_type_name(enum llama_flash_attn_type flash_attn_type);
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 9ee64b566..993328dd1 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -314,6 +314,8 @@ llama_context::llama_context(
     }
 
     cparams.flash_attn = params.flash_attn_type != LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    cparams.flash_attn_small_batch = params.flash_attn_type == LLAMA_FLASH_ATTN_TYPE_SMALL_BATCH &&
+                                     !ggml_is_quantized(params.type_k) && !ggml_is_quantized(params.type_v);
     cparams.auto_fa    = params.flash_attn_type == LLAMA_FLASH_ATTN_TYPE_AUTO;
 
     cparams.fused_gdn_ar = true;
diff --git a/src/llama-cparams.h b/src/llama-cparams.h
index f4eb181a7..38947843f 100644
--- a/src/llama-cparams.h
+++ b/src/llama-cparams.h
@@ -38,6 +38,7 @@ struct llama_cparams {
     bool causal_attn;
     bool offload_kqv;
     bool flash_attn;
+    bool flash_attn_small_batch; // the matmul attention for long batches on the full-attention layers
     bool auto_fa;
     bool fused_gdn_ar;       // use fused gated delta net (autoregressive)
     bool fused_gdn_ch;       // use fused gated delta net (chunked)
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index f69fe63f8..249d9671a 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2880,7 +2880,12 @@ ggml_tensor * llm_graph_context::build_attn_mha(
 
     ggml_tensor * cur;
 
-    const bool use_flash_attn = cparams.flash_attn && kq_b == nullptr;
+    // LLAMA_FLASH_ATTN_TYPE_SMALL_BATCH: a batch of more than 8 tokens on a layer without a sliding window goes through
+    // the matmul attention (V, stored in the flash-attention layout, is transposed for it). A sliding-window layer keeps
+    // flash attention, which skips the masked blocks of a full-size SWA cache.
+    const bool small_batch_mm = cparams.flash_attn_small_batch && q->ne[1] > 8 && !(il >= 0 && hparams.is_swa(il));
+
+    const bool use_flash_attn = cparams.flash_attn && kq_b == nullptr && !small_batch_mm;
     if (use_flash_attn) {
         GGML_ASSERT(kq_b == nullptr && "Flash attention does not support KQ bias yet");
 
diff --git a/src/llama.cpp b/src/llama.cpp
index 9beb14841..59d4d5e0d 100644
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -43,6 +43,8 @@ const char * llama_flash_attn_type_name(enum llama_flash_attn_type flash_attn_ty
             return "disabled";
         case LLAMA_FLASH_ATTN_TYPE_ENABLED:
             return "enabled";
+        case LLAMA_FLASH_ATTN_TYPE_SMALL_BATCH:
+            return "small_batch";
     }
     GGML_ABORT("fatal error");
 }
diff --git a/tools/llama-bench/llama-bench.cpp b/tools/llama-bench/llama-bench.cpp
index 96ae4870f..141112c50 100644
--- a/tools/llama-bench/llama-bench.cpp
+++ b/tools/llama-bench/llama-bench.cpp
@@ -475,7 +475,7 @@ static void print_usage(int /* argc */, char ** argv) {
