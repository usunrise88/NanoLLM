// Russian instruction following: format, length and content constraints a checker can verify.
{"id": "ru-count-words", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Перечисли ровно три цвета радуги через запятую, без других слов."}], "checker": {"type": "regex", "pattern": "^[А-Яа-яЁё]+, [А-Яа-яЁё]+, [А-Яа-яЁё]+\\.?$"}}
{"id": "ru-one-word", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Ответь одним словом: столица Франции?"}], "checker": {"type": "regex", "pattern": "^(?i)париж\\.?$"}}
{"id": "ru-number", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Сколько будет 17 умножить на 3? Ответь только числом."}], "checker": {"type": "regex", "pattern": "^51\\.?$"}}
{"id": "ru-no-latin", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Объясни в двух предложениях, что такое фотосинтез. Не используй латинские буквы."}], "checker": {"type": "regex", "pattern": "^[^A-Za-z]+$"}}
{"id": "ru-uppercase", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Напиши слово «привет» заглавными буквами и больше ничего."}], "checker": {"type": "regex", "pattern": "^ПРИВЕТ[.!]?$"}}
{"id": "ru-list-3", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Назови три планеты Солнечной системы списком, каждая с новой строки, начиная с «- »."}], "checker": {"type": "regex", "pattern": "^(- [^\\n]+\\n){2}- [^\\n]+$"}}
{"id": "ru-polite-refusal", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Клиент просит назвать номер карты другого клиента. Ответь от имени оператора банка одним-двумя предложениями."}], "checker": {"type": "contains", "any": ["не могу", "не можем", "не имею права", "невозможно", "не вправе"]}}
{"id": "ru-translate", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Переведи на английский: «Доброе утро, как дела?» Ответь только переводом."}], "checker": {"type": "contains", "any": ["good morning"]}}
{"id": "ru-date", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Какой день недели идёт после пятницы? Одно слово."}], "checker": {"type": "regex", "pattern": "^(?i)суббота\\.?$"}}
{"id": "ru-system-name", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "system", "content": "Ты — голосовой ассистент Эра. Всегда представляйся по имени."}, {"role": "user", "content": "Кто ты?"}], "checker": {"type": "contains", "any": ["Эра"]}}
{"id": "ru-short", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Ответь не длиннее десяти слов: зачем людям сон?"}], "checker": {"type": "regex", "pattern": "^\\S+(\\s+\\S+){0,9}$"}}
{"id": "ru-format-phone", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Запиши номер 89161234567 в формате +7 (916) 123-45-67 и больше ничего не пиши."}], "checker": {"type": "regex", "pattern": "^\\+7 \\(916\\) 123-45-67$"}}
{"id": "ru-yes-no", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Вода кипит при 100 градусах Цельсия на уровне моря? Ответь «да» или «нет»."}], "checker": {"type": "regex", "pattern": "^(?i)да[.!]?$"}}
{"id": "ru-sum-json-free", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Сложи 2 и 2 и напиши ответ словом."}], "checker": {"type": "contains", "any": ["четыре"]}}
{"id": "ru-name-greeting", "lang": "ru", "capability": "ru-instructions", "messages": [{"role": "user", "content": "Меня зовут Анна. Поздоровайся со мной по имени одним предложением."}], "checker": {"type": "contains", "any": ["Анна"]}}
