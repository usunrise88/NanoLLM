// English instruction following: format, length and content constraints a checker can verify.
{"id": "en-three-colors", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "List exactly three colors of the rainbow separated by commas, with no other words."}], "checker": {"type": "regex", "pattern": "^[A-Za-z]+, [A-Za-z]+, [A-Za-z]+\\.?$"}}
{"id": "en-one-word", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Answer in one word: what is the capital of Japan?"}], "checker": {"type": "regex", "pattern": "^(?i)tokyo\\.?$"}}
{"id": "en-number", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "What is 17 multiplied by 3? Answer with the number only."}], "checker": {"type": "regex", "pattern": "^51\\.?$"}}
{"id": "en-no-digits", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Explain in two sentences what photosynthesis is. Do not use any digits."}], "checker": {"type": "regex", "pattern": "^[^0-9]+$"}}
{"id": "en-uppercase", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Write the word \"hello\" in capital letters and nothing else."}], "checker": {"type": "regex", "pattern": "^HELLO[.!]?$"}}
{"id": "en-list-3", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Name three planets of the Solar System as a list, one per line, each line starting with \"- \"."}], "checker": {"type": "regex", "pattern": "^(- [^\\n]+\\n){2}- [^\\n]+$"}}
{"id": "en-polite-refusal", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "A customer asks you to read out another customer's card number. Reply as a bank operator in one or two sentences."}], "checker": {"type": "contains", "any": ["cannot", "can't", "can not", "unable", "not able", "not allowed", "not permitted", "unfortunately"]}}
{"id": "en-translate", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Translate into French: \"Good morning, how are you?\" Answer with the translation only."}], "checker": {"type": "contains", "any": ["bonjour"]}}
{"id": "en-weekday", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Which day of the week comes after Friday? One word."}], "checker": {"type": "regex", "pattern": "^(?i)saturday\\.?$"}}
{"id": "en-system-name", "lang": "en", "capability": "en-instructions", "messages": [{"role": "system", "content": "You are an assistant named Nika. Always introduce yourself by name."}, {"role": "user", "content": "Who are you?"}], "checker": {"type": "contains", "any": ["Nika"]}}
{"id": "en-short", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Answer in no more than ten words: why do people need sleep?"}], "checker": {"type": "regex", "pattern": "^\\S+(\\s+\\S+){0,9}$"}}
{"id": "en-format-phone", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Write the number 4155550123 in the format (415) 555-0123 and write nothing else."}], "checker": {"type": "regex", "pattern": "^\\(415\\) 555-0123$"}}
{"id": "en-yes-no", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Does water boil at 100 degrees Celsius at sea level? Answer \"yes\" or \"no\"."}], "checker": {"type": "regex", "pattern": "^(?i)yes[.!]?$"}}
{"id": "en-sum-word", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Add 2 and 2 and write the answer as a word."}], "checker": {"type": "contains", "any": ["four"]}}
{"id": "en-name-greeting", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "My name is Anna. Greet me by name in one sentence."}], "checker": {"type": "contains", "any": ["Anna"]}}
{"id": "en-json-keys", "lang": "en", "capability": "en-instructions", "messages": [{"role": "user", "content": "Reply with a JSON object with the keys \"name\" and \"age\" for a person called Tom, aged 30. Output the JSON only."}], "checker": {"type": "json"}}
